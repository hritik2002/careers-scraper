# OpenAI API key for resume matching
OPENAI_API_KEY=sk-...

# Email (SMTP) — works with Gmail, Outlook, SendGrid SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your.email@gmail.com
EMAIL_TO=your.email@gmail.com

# Optional overrides (defaults shown)
# RESUME_PATH=./resume.md
# CONFIG_PATH=./config.json
# CAREER_PAGES_FROM_JSON=1
# MIN_FIT_SCORE=2.5
# OPENAI_MODEL=gpt-4o-mini
# CRON_TZ=Asia/Kolkata

# ATS job discovery (npm run discover-jobs) — pick one provider:
# SERPER_API_KEY=...              # https://serper.dev (recommended, 2500 free queries)
# GOOGLE_API_KEY=...
# GOOGLE_CSE_ID=...               # Google Programmable Search Engine ID
